
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/projetos/publicar",
      "destination": "/index.html"
    },
    {
      "source": "/projetos/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/projetos",
      "destination": "/index.html"
    },
    {
      "source": "/comunidade/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/comunidade",
      "destination": "/index.html"
    },
    {
      "source": "/talentos",
      "destination": "/index.html"
    },
    {
      "source": "/entrar",
      "destination": "/index.html"
    },
    {
      "source": "/cadastro",
      "destination": "/index.html"
    },
    {
      "source": "/sobre",
      "destination": "/index.html"
    },
    {
      "source": "/privacidade",
      "destination": "/index.html"
    },
    {
      "source": "/termos",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
